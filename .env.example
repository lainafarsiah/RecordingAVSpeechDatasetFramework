APP_ENV=production
ADMIN_BASE_PATH=/admin
SESSION_SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_PASSWORD=replace-with-a-long-unique-password
BIND_HOST=127.0.0.1
PORT=8000
WEB_WORKERS=4
MEDIA_LOCAL_WORKERS=2
MEDIA_MAX_ACTIVE=4
MEDIA_MAX_PENDING=1000
MAX_UPLOAD_MB=100
FFMPEG_THREADS=2
FFMPEG_TIMEOUT=180
TRUSTED_PROXY_IPS=127.0.0.1
CONSENT_VERSION=replace-with-approved-version
CONSENT_TEXT_PATH=consent_forms/consent.pdf
EXPLAINER_SIGNATURE_PATH=consent_forms/explainer_signature.png
